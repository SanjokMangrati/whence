{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:demo": "wrangler deploy --env demo",
    "cf-typegen": "wrangler types",
    "lint": "eslint src eval",
    "typecheck": "wrangler types && tsc --noEmit && tsc -p eval",
    "test": "vitest run",
    "eval": "node eval/run.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mozilla/readability": "^0.6.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "better-auth": "^1.7.14",
    "docx": "^9.15.0",
    "dodopayments": "^2.59.0",
    "drizzle-orm": "^0.45.4",
    "entitlements": "workspace:*",
    "hono": "^4.13.14",
    "linkedom": "^0.18.14",
    "notes-format": "workspace:*",
    "pdf-lib": "^1.17.1",
    "posthog-node": "^5.57.2",
    "redact": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "jszip": "^3.10.2",
    "standardwebhooks": "^1.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.154.0"
  }
}
