{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:demo": "wrangler deploy --env demo",
    "cf-typegen": "wrangler types",
    "lint": "eslint src",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mozilla/readability": "^0.6.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "entitlements": "workspace:*",
    "hono": "^4.13.14",
    "linkedom": "^0.18.14",
    "posthog-node": "^5.57.2",
    "redact": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
