  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "eslint": "^9.39.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.154.0",
    "vitest": "^5.0.5"
  }
