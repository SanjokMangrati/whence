{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whence-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "whence" }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
  ],
  "vars": { "POSTHOG_HOST": "https://eu.i.posthog.com" },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "RESEND_API_KEY",
      "MAIL_FROM",
      "POSTHOG_KEY",
    ],
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "env": {
    "demo": {
      "d1_databases": [{ "binding": "DB", "database_name": "whence-demo" }],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
      ],
      "vars": { "POSTHOG_HOST": "https://eu.i.posthog.com" },
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "BETTER_AUTH_URL",
          "RESEND_API_KEY",
          "MAIL_FROM",
          "POSTHOG_KEY",
        ],
      },
    },
  },
}
