{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whence-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{ "binding": "DB", "database_name": "whence" }],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "env": {
    "demo": {
      "d1_databases": [{ "binding": "DB", "database_name": "whence-demo" }],
    },
  },
}
