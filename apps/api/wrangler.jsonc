{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whence-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "whence" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "whence-content" }],
  "workflows": [
    {
      "name": "whence-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow",
    },
  ],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    {
      "name": "GENERATION_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "POSTHOG_HOST": "https://eu.i.posthog.com",
    "GENERATOR_MODEL_ID": "claude-haiku-4-5-20251001",
    "GENERATOR_INPUT_USD_PER_MTOK": 1,
    "GENERATOR_OUTPUT_USD_PER_MTOK": 5,
    "DAILY_SOURCE_LIMIT": 40,
  },
  "secrets": {
    "required": [
      "ANTHROPIC_API_KEY",
      "JEV_API_KEY",
      "SUPADATA_API_KEY",
      "YOUTUBE_API_KEY",
      "KEY_ENCRYPTION_SECRET",
      "BETTER_AUTH_SECRET",
      "BETTER_AUTH_URL",
      "RESEND_API_KEY",
      "MAIL_FROM",
      "POSTHOG_KEY",
    ],
  },
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "env": {
    "demo": {
      "d1_databases": [{ "binding": "DB", "database_name": "whence-demo" }],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "whence-demo-content" }],
      "workflows": [
        {
          "name": "whence-demo-generation",
          "binding": "GENERATION_WORKFLOW",
          "class_name": "GenerationWorkflow",
        },
      ],
      "ratelimits": [
        { "name": "AUTH_LIMITER", "namespace_id": "2001", "simple": { "limit": 20, "period": 60 } },
        {
          "name": "GENERATION_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
      "vars": {
        "POSTHOG_HOST": "https://eu.i.posthog.com",
        "GENERATOR_MODEL_ID": "claude-haiku-4-5-20251001",
        "GENERATOR_INPUT_USD_PER_MTOK": 1,
        "GENERATOR_OUTPUT_USD_PER_MTOK": 5,
        "DAILY_SOURCE_LIMIT": 40,
        "DEMO_TRANSCRIPT_CREDITS": 90,
        "DEMO_VERIFIER_MICRO_USD": 10000000,
        "DEMO_VERIFIER_MICRO_USD_PER_CALL": 100,
      },
      "secrets": {
        "required": [
          "JEV_API_KEY",
          "SUPADATA_API_KEY",
          "YOUTUBE_API_KEY",
          "KEY_ENCRYPTION_SECRET",
          "BETTER_AUTH_SECRET",
          "BETTER_AUTH_URL",
          "RESEND_API_KEY",
          "MAIL_FROM",
          "POSTHOG_KEY",
          "TURNSTILE_SECRET_KEY",
        ],
      },
    },
  },
}
