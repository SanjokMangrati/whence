{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whence-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "whence-web" },
    { "binding": "API", "service": "whence-api" },
  ],
  "env": {
    "demo": {
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "whence-web-demo" },
        { "binding": "API", "service": "whence-api-demo" },
      ],
    },
  },
}
